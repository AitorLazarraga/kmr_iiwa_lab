# Goal
geometry_msgs/Point wall_p1 #Extremo1 Pared
geometry_msgs/Point wall_p2 #Extremo2 Pared
float64 distance #Distancia entre robot y pared
float64 shift #Desplazamiento para odometria
float64 lateral #lateral esperado al final

---

# Result

bool success #Correcto no Correcto
string message #Mensaje en caso de fallo
float64 final_distance_error #Error distancia
float64 final_lateral_error #Error lateral
float64 final_angle_error #Error angular
float64 traveled #Distancia recorrida

---

# Feedback

string phase #accelerating, cruising, braking, checking
float64 traveled #Distancia recorrida
float64 speed #Vel actual
